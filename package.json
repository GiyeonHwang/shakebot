{
  "name": "discord-team-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "register": "node --env-file-if-exists=.env dist/register.js"
  },
  "dependencies": {
    "discord.js": "14.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
